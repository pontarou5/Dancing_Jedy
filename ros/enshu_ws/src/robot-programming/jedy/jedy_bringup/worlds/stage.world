<sdf version='1.4'>
  <world name='default'>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Dark ambient for dramatic stage feel -->
    <scene>
      <shadows>0</shadows>
      <ambient>0.05 0.05 0.05 1</ambient>
      <background>0.02 0.02 0.02 1</background>
    </scene>

    <!-- Camera: front-of-stage view (audience perspective, +Y → -Y) -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 3.0 1.2 0 0.35 -1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- ============================================================
         STAGE LIGHTS
         Three-point theatrical lighting setup:
           spot_center  : warm white key light directly above robot
           spot_left    : warm orange fill (stage left = robot's right)
           spot_right   : cool blue fill  (stage right = robot's left)
    ============================================================ -->
    <light type="spot" name="spot_center">
      <pose>0 0 3.5 0 0 0</pose>
      <diffuse>0.5 0.48 0.42 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>1.0</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="spot" name="spot_left">
      <pose>-1.2 0.5 3.0 0 0 0</pose>
      <diffuse>0.45 0.18 0.04 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.3 -0.2 -1</direction>
      <spot>
        <inner_angle>0.4</inner_angle>
        <outer_angle>0.8</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="spot" name="spot_right">
      <pose>1.2 0.5 3.0 0 0 0</pose>
      <diffuse>0.08 0.22 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 -0.2 -1</direction>
      <spot>
        <inner_angle>0.4</inner_angle>
        <outer_angle>0.8</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============================================================
         STAGE FLOOR  (visual only – no collision, so robot physics
         is unaffected; sits just above the ground plane)
    ============================================================ -->
    <model name="stage_floor">
      <static>1</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>2.5 2.5 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         BACKDROP  (black flat wall behind the robot)
    ============================================================ -->
    <model name="stage_backdrop">
      <static>1</static>
      <pose>0 -1.4 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.6 0.08 2.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.6 0.08 2.6</size></box>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         SIDE CURTAINS (dark red stage wings)
    ============================================================ -->
    <model name="stage_curtain_left">
      <static>1</static>
      <pose>-1.4 -0.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.08 2.4 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 2.4 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.0 0.0 1</ambient>
            <diffuse>0.40 0.0 0.0 1</diffuse>
            <specular>0.01 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="stage_curtain_right">
      <static>1</static>
      <pose>1.4 -0.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.08 2.4 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 2.4 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.0 0.0 1</ambient>
            <diffuse>0.40 0.0 0.0 1</diffuse>
            <specular>0.01 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         VALANCE  (horizontal border across the top of the opening)
    ============================================================ -->
    <model name="stage_valance">
      <static>1</static>
      <pose>0 0.2 2.6 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.08 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.0 0.0 1</ambient>
            <diffuse>0.40 0.0 0.0 1</diffuse>
            <specular>0.01 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         LIGHTING RIG BAR  (thin overhead truss the spotlights hang from)
    ============================================================ -->
    <model name="stage_rig_bar">
      <static>1</static>
      <pose>0 0 3.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.04 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rig bar vertical supports -->
    <model name="stage_rig_post_left">
      <static>1</static>
      <pose>-1.4 0 1.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 1.6</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="stage_rig_post_right">
      <static>1</static>
      <pose>1.4 0 1.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 1.6</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
